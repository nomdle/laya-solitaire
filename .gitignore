# ===============================
# 파이썬 캐시 및 가상환경
# ===============================
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/

# ===============================
# 모델 가중치 및 학습 체크포인트 (대용량)
# ===============================
checkpoint-*/
*.pt
*.pth
*.bin
*.safetensors

# ===============================
# 대용량 수집 데이터셋 (재현을 위해 수집 스크립트 제공)
# ===============================
dataset/*.jsonl
!dataset/.gitkeep

# ===============================
# OS 및 IDE 설정
# ===============================
.vscode/
.idea/
.DS_Store
Thumbs.db
